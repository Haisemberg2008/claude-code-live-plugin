# Supply-chain policy, enforced instead of documented.
#
# runtime/README.md described these as rules to remember on the command line and
# noted that the file did not exist yet. Nothing about them depends on who is
# typing, so they belong here.

# No package may run install-time scripts in this tree.
ignore-scripts=true

# Every dependency is pinned to one exact version; the lockfile is authoritative.
save-exact=true
save-prefix=
package-lock=true

# Installing must never reach outside this project.
global=false
